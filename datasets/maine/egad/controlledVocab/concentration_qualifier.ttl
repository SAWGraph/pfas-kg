    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.S a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "REPORTED VALUE WAS DETERMINED BY METHOD OF STANDARD ADDITIONS (MSA)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.SA a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "SATURATED" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.SP a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "SLIGHTLY POSITIVE" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.T a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "ANALYTE RECALCULATED AGAINST ALTERNATE LABELED COMPOUND(S) OR INTERNAL STANDARD" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.T-EMPC a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "ANALYTE RECALCULATED AGAINST ALTERNATE LABELED COMPOUND(S) OR INTERNAL STANDARD AND PEAK DETECTED, BUT DID NOT MEET QUANTIFICATION CRITERIA, RESULT REPORTED REPRESENTS THE ESTIMATED MAXIMUM POSSIBLE CONCENTRATION" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.TN a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "BACTERIAL RESULTS REPORTED TOO NUMEROUS TO COUNT" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.TR a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "TRACE (IRON AND SULFUR REDUCING BACTERIA)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.U a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "NOT DETECTED ABOVE THE ASSOCIATED QUANTITATION LIMIT" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.UH a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "HISTORICAL DATA IDENTIFIED AS NON-DETECT BUT WITH OUT A REPORTING LIMIT PROVIDED" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.UJ a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "NOT DETECTED ABOVE THE ASSOCIATED QUANTITATION LIMIT AND ESTIMATED DUE TO VARIOUS QC DEVIATIONS, INCLUDING ELEVATED OR ESTIMATED QUANTITATION LIMIT." ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.UJH a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "HISTORICAL DATA WITHOUT A REPORTING LIMIT PROVIDED--NOT DETECTED ABOVE ELEVATED QUANTITATION LIMIT" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.UT a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "NOT DETECTED ABOVE THE ASSOCIATED QUANTITATION LIMIT; AND ANALYTE RECALCULATED AGAINST ALTERNATE LABELED COMPOUND(S) OR INTERNAL STANDARD" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.Z a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "SURROGATE OR SPIKE DILUTED OUT OF SAMPLE" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.s a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "QC RESULTS NOT WITHIN CONTROL LIMITS" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.s-EMPC a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "QC RESULTS NOT WITHIN CONTROL LIMITS/PEAK DETECTED, BUT DID NOT MEET QUANTIFICATION CRITERIA, RESULT REPORTED REPRESENTS THE ESTIMATED MAXIMUM POSSIBLE CONCENTRATION" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

