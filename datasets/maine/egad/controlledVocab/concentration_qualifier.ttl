    rdfs:label "MODERATE TO HIGH/HEAVY (IRON AND SULFUR REDUCING BACTERIA)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.MI a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "MATRIX INTERFERENCE" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.MO a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "MODERATE (IRON AND SULFUR REDUCING BACTERIA)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.N a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "PRESENCE OF AN ANALYTE IN WHICH A TENTATIVE ID CAN BE MADE AND VALUE REPRESENTS ITS APPROXIMATE CONCENTRATION" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.NAN a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
