me_egad:concentrationQualifier.P a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "(PESTICIDE/AROCLOR) EXCEEDS ACCEPTABLE % DIFFERENCE BETWEEN THE ORIGINAL AND CONFIRMATION ANALYSES." ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.PASS a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "RESULT PASSES (CRITERIA BASED ON THE METHOD)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.PK a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "SLIGHTLY POSITIVE (OILSCREEN TEST)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.PO a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "POSITIVE (COLIFORM BACTERIA AND OILSCREEN TESTS)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.R a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
