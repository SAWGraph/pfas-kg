    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.EMPC a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "PEAK DETECTED, BUT DID NOT MEET QUANTIFICATION CRITERIA, RESULT REPORTED REPRESENTS THE ESTIMATED MAXIMUM POSSIBLE CONCENTRATION" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.Es a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "REPORTED VALUE IS ESTIMATED DUE TO PRESENCE OF INTERFERENCE (INORGANIC) OR COMPOUND EXCEEDED UPPER LEVEL OF CALIBRATION RANGE (ORGANIC) AND QC RESULTS ARE NOT WITHIN CONTROL LIMITS" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.FAIL a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "RESULT FAILS (CRITERIA BASED ON THE METHOD)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.G a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "GREATER THAN SPECIFIED AMOUNT" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.H a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "HIGH/HEAVY (IRON AND SULFUR REDUCING BACTERIA)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.J a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "ASSOCIATED VALUE IS ESTIMATED - MAY BE DUE TO FACTORS SUCH AS HOLDING TIME VIOLATIONS, BLANK CONTAMINATION, ETC." ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.J-EMPC a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "PEAK DETECTED, BUT DID NOT MEET QUANTIFICATION CRITERIA, RESULT REPORTED REPRESENTS THE ESTIMATED MAXIMUM POSSIBLE CONCENTRATION & ASSOCIATED VALUE IS AN ESTIMATE BELOW QUANTITATION/ REPORTING LIMIT OR INDICATES AN ESTIMATED RESULT DUE TO AN ASSOCIATED QC" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.JB a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "ASSOCIATED VALUE IS AN ESTIMATE, COMPOUND IS FOUND IN THE ASSOCIATED METHOD BLANK." ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.JG a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "ASSOCIATED VALUE IS ESTIMATED - MAY BE DUE TO FACTORS SUCH AS HOLDING TIME VIOLATIONS, BLANK CONTAMINATION, ETC. AND VALUE IS GREATER THAN SPECIFIED AMOUNT" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.Js a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "ASSOCIATED VALUE IS ESTIMATED AND QC RESULTS NOT WITHIN CONTROL LIMITS" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.K a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "TRACE LEVEL BELOW STATED REPORTING LIMIT (HETL)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.L a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "LIGHT (IRON AND SULFUR REDUCING BACTERIA)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.LQV a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
