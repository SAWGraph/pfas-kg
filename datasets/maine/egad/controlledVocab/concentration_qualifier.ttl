    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.LT a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "LESS THAN SPECIFIED AMOUNT (NON-LAB DATA ONLY)" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.MD a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "MODEL L&W" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.MDO a me_egad:EGAD-ConcentrationQualifier,
        owl:NamedIndividual ;
    rdfs:label "MODEL-OLD L&W" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/concentration_qualifier> .

me_egad:concentrationQualifier.MH a me_egad:EGAD-ConcentrationQualifier,
