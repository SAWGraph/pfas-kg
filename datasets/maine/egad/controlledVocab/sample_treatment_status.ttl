me_egad:treatmentStatus.N a me_egad:EGAD-SampleTreatmentStatus,
        owl:NamedIndividual ;
    rdfs:label "NOT TREATED" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/sample_treatment_status> .

me_egad:treatmentStatus.T a me_egad:EGAD-SampleTreatmentStatus,
        owl:NamedIndividual ;
    rdfs:label "TREATED" ;
    rdfs:isDefinedBy <https://w3id.org/sawgraph/v1/me-egad/controlledVocab/sample_treatment_status> .

<https://w3id.org/sawgraph/v1/me-egad/controlledVocab/sample_treatment_status> a owl:Ontology ;
    dcterms:description "Controlled Vocabulary for Maine EGAD sample_treatment_status" ;
    dcterms:modified "2026-05-20"^^xsd:date ;
    dcterms:title "Maine EGAD Controlled Vocabulary - sample_treatment_status"^^xsd:string .

