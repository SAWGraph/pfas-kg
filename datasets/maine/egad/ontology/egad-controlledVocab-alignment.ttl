@prefix coso: <http://w3id.org/coso/v1/contaminoso#> .
@prefix dsstox: <http://w3id.org/DSSTox/v1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix me_egad: <http://w3id.org/sawgraph/v1/me-egad#> .
@prefix me_egad_data: <http://w3id.org/sawgraph/v1/me-egad-data#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment> rdf:type owl:Ontology ;
                                             terms:contributor <http://orcid.org/0000-0002-5331-5052> ,
                                                           <http://orcid.org/0000-0003-3547-8058> ,
                                                            <https://orcid.org/0000-0003-3271-6700>;
                                             terms:created "2024-07-26" ;
                                             terms:creator <http://orcid.org/0000-0002-5331-5052> ,
                                                           <http://orcid.org/0000-0003-3547-8058> ,
                                                           <https://orcid.org/0000-0003-3271-6700> ;
                                             terms:description "This ontology supports SAWGraph"@en ;
                                             terms:title "Ontology for Maine Environmental and Geographic Analysis Database (EGAD) PFAS Dataset Sample Type mapping"@en ;
                                             owl:versionInfo "1.0"@en .

#me_egad:sampleMaterialType.SW
me_egad:DefEGADSurfaceWaterSample owl:equivalentClass [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.SW
  ];
     rdfs:subClassOf coso:SurfaceWaterSample;  #need to add sample location 
     rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>.

#me_egad:sampleMaterialType.GW #groundwater
#me_egad:sampleMaterialType.PO #pore water
me_egad:DefEGADGroundWaterSample owl:unionOf (
  [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.GW
  ]
  [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.PO]
  [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialTypeQualifier.AR
  ]
  );
     rdfs:subClassOf coso:GroundWaterSample; #need to add sample location 
     rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>. 

#me_egad:sampleMaterialType.DW #drinking water
me_egad:DefEGADDrinkingWaterSample owl:unionOf ([rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.DW]
  [rdf:type owl:Restriction;
    owl:onProperty me_egad:sampleCollectionMethod;
    owl:hasValue me_egad:sampleLocation.T] #inside tap
    [rdf:type owl:Restriction;
    owl:onProperty me_egad:sampleCollectionMethod;
    owl:hasValue me_egad:sampleLocation.OT]  #outside tap
);

     rdfs:subClassOf coso:DrinkingWaterSample;
     rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>. #need to add sample location 

me_egad:DefEGADFilteredWaterSample owl:unionOf (
    [rdf:type owl:Restriction; 
    owl:onProperty me_egad:sampleCollectionLocation;
    owl:hasValue me_egad:sampleLocation.AF]  #after filter
    
);
  rdfs:subClassOf coso:FilteredWaterSample;
  rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>. 

me_egad:DefEGADTreatedWaterSample owl:unionOf (
    [rdf:type owl:Restriction;
    owl:onProperty me_egad:sampleCollectionLocation;
    owl:hasValue me_egad:sampleLocation.EF] #treatment system effluent
    [rdf:type owl:Restriction;
    owl:onProperty me_egad:sampleCollectionLocation;
    owl:hasValue me_egad:sampleLocation.AS] #after softener
    [ rdf:type owl:Restriction;
    owl:onProperty me_egad:sampleTreatmentStatus;
    owl:hasValue me_egad:treatmentStatus.T] #treated
);
  rdfs:subClassOf coso:TreatedWaterSample;
  rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>. 

me_egad:DefEGADRawWaterSample owl:unionOf (
  [rdf:type owl:Restriction;
    owl:onProperty me_egad:sampleCollectionLocation;
    owl:hasValue me_egad:sampleLocation.BE] #before filter
  [ rdf:type owl:Restriction;
    owl:onProperty me_egad:sampleCollectionLocation;
    owl:hasValue me_egad:sampleLocation.PU] #wellhead
  [ rdf:type owl:Restriction;
    owl:onProperty me_egad:sampleTreatmentStatus;
    owl:hasValue me_egad:treatmentStatus.N] #not treated
);
  rdfs:subClassOf coso:RawWaterSample;
 rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>. 

#me_egad:sampleMaterialType.SL  #soil
me_egad:DefEGADSoilSample owl:equivalentClass [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.SL];
    rdfs:subClassOf coso:SoilSample.

#me_egad:sampleMaterialType.SD #sediment
#me_egad:sampleMaterialType.SWS #surface water substrate
me_egad:DefEGADSedimentSample owl:unionOf ( [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.SD]
  [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.SWS
  ]);
    rdfs:subClassOf coso:SedimentSample;
    rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>.

#me_egad:sampleMaterialType.MA #manure
#me_egad:sampleMaterialType.CO #compost #ash #flyash
me_egad:DefEGADSolidWasteSample owl:unionOf (
  [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.MA
  ]
  [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.AS #ash
  ]
  [	rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.FA #fly ash
]);
  rdfs:subClassOf coso:SolidWasteSample;
  rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>. 

#me_egad:sampleMaterialType.L #leachate 
#me_egad:sampleMaterialType.RIN #rinsate 
#	me_egad:sampleMaterialType.WW #wastewater
#me_egad:sampleMaterialType.SPG #septage
#me_egad:sampleMaterialType.SU #sludge
#me_egad:sampleMaterialType.PW #process water
me_egad:DefEGADWasteWaterSample owl:unionOf (
  [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.L ]
  [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.RIN]
    [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.WW]
  [rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.SPG]
[rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.PW]
[rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.SU
]);
  rdfs:subClassOf coso:WasteWaterSample;
  rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>. 

#me_egad:sampleMaterialType.BC #bedrock chips
#me_egad:sampleMaterialType.BM #building material
#me_egad:sampleMaterialType.POL #polymer
#me_egad:sampleMaterialType.SA #sawdust
me_egad:DefEGADSolidMaterials owl:unionOf (
  [rdf:type owl:Restriction;
    owl:onProperty coso:sampleOfMaterialType;
    owl:hasValue me_egad:sampleMaterialType.BC]
      [rdf:type owl:Restriction;
    owl:onProperty coso:sampleOfMaterialType;
    owl:hasValue me_egad:sampleMaterialType.BM]
      [rdf:type owl:Restriction;
    owl:onProperty coso:sampleOfMaterialType;
    owl:hasValue me_egad:sampleMaterialType.POL]
      [rdf:type owl:Restriction;
    owl:onProperty coso:sampleOfMaterialType;
    owl:hasValue me_egad:sampleMaterialType.SA]
); rdfs:subClassOf coso:SolidMaterialSample;
rdfs:isDefinedBy <http://w3id.org/sawgraph/v1/me-egad/controlledVocab/alignment>. 


me_egad:DefEGADFishFillet owl:unionOf([
  rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.SF]
  [ rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.SOF]);
  owl:equivalentClass obo:FOODON_0000267; #fish fillet
  #obo:RO_0002162 obo:
  rdfs:subClassOf coso:AnimalTissueSample.

me_egad:DefEGADWholeMarineAnimal owl:intersectionOf (
  owl:unionOf(
  [ rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.WH] #whole
  [ rdf:type owl:Restriction;
  owl:onProperty coso:sampleOfMaterialType;
  owl:hasValue me_egad:sampleMaterialType.WS] ) #whole without skin
  [ rdf:type owl:Restriction;
  owl:onProperty prov:wasAttributedTo;
  owl:hasValue me_egad_data:SWATMW]);
  rdfs:subClassOf coso:AnimalMaterialSample. 


